{
  "services": {
    "frontend": {
      "root": "frontend/",
      "buildCommand": "npm install && npm run build",
      "outputDirectory": "build"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/predict", "destination": { "service": "backend" } },
    { "source": "/predict/batch", "destination": { "service": "backend" } },
    { "source": "/explain", "destination": { "service": "backend" } },
    { "source": "/explain/batch", "destination": { "service": "backend" } },
    { "source": "/explain/shap", "destination": { "service": "backend" } },
    { "source": "/explain/lime", "destination": { "service": "backend" } },
    { "source": "/anomaly", "destination": { "service": "backend" } },
    { "source": "/counterfactual", "destination": { "service": "backend" } },
    { "source": "/optimize", "destination": { "service": "backend" } },
    { "source": "/feature-importance", "destination": { "service": "backend" } },
    { "source": "/template/csv", "destination": { "service": "backend" } },
    { "source": "/model/info", "destination": { "service": "backend" } },
    { "source": "/model/validation", "destination": { "service": "backend" } },
    { "source": "/questionnaire/submit", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
